# NEXT_PUBLIC variables are accessible on the client
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Private variables (server-only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# External Services (Backend Adapters)
# Do NOT prefix with NEXT_PUBLIC to keep them secure on the server
AGMARKNET_API_KEY=optional_agmarknet_key
IMD_WEATHER_API_KEY=optional_imd_key
SENTINEL_API_KEY=optional_sentinel_key
OCR_SERVICE_API_KEY=optional_ocr_key
